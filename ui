getgenv()._CONFIGS = {
    UI_NAME = "UI",
}
loadstring(game:HttpGet("https://pastebin.com/raw/CxxfciVn"))()

local mainTab = library:CreateTab("栏目")

mainTab:NewSeparator()

mainTab:NewButton("点击式按钮", function() end)

mainTab:NewToggle("启用功能", "en_g", false, function(state)
    if state then
        print("ok")
    else
        print("fok")
    end
end)

mainTab:NewSlider("滑块", "s_g", 50, 0, 100, false, function(value)
    print("设到: " .. value)
end)

local options = { "1", "2", "3" }
mainTab:NewDropdown("下拉选择", "o_g", options, function(selected)
    print("选择: " .. selected)
end)

mainTab:NewBind("按键绑定", "E", function(key)
    print("键: " .. key)
end)

mainTab:NewBox("输入", "gbg", function(text)
    print("测试: " .. text)
end)
